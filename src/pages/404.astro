---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <h1 class="mb-4 text-3xl font-semibold">Page not found</h1>
  <p>The page you were looking for could not be found. It might have been removed, renamed, or did not exist in the first place.</p>
  <p class="mt-4"><a href="/" class="text-accent hover:underline">Go to the home page</a> or <a href="/blog/" class="text-accent hover:underline">browse the blog</a>.</p>
</Base>
